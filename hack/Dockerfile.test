# Reproducible test environment: Go + OpenLDAP (slapd). See `make test-docker`.
# Same image locally and in CI.
FROM golang:1.27.4-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends slapd ldap-utils curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# In CI a missing slapd must fail the run, not silently skip the integration tests.
ENV LDAPNAV_REQUIRE_SLAPD=1
CMD ["bash", "hack/ci-test.sh"]
