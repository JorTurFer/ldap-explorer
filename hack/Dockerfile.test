# Reproducible test environment: Go + OpenLDAP (slapd). See `make test-docker`.
# Same image locally and in CI.
FROM golang:1.27.4-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends slapd ldap-utils curl chromium nodejs fonts-liberation fonts-dejavu-core fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY e2e/go.mod e2e/go.sum ./e2e/
RUN cd e2e && go mod download
COPY . .

# In CI a missing slapd, Chrome or Node must fail the run, not silently skip tests.
ENV LDAPNAV_REQUIRE_SLAPD=1 LDAPNAV_REQUIRE_CHROME=1 LDAPNAV_REQUIRE_NODE=1
CMD ["bash", "hack/ci-test.sh"]
